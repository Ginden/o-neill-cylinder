{
  "name": "oneill-atmosphere-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test:render": "playwright test tests/browser/clouds.spec.ts tests/browser/refinement.spec.ts --grep \"sparse cloud|cloud filtering depth|crown\""
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.19.2",
    "@types/three": "^0.183.1",
    "eslint": "^10.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
